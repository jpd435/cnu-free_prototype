{
  "name": "cnu-free",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "CNU Free — University Schedule & Shared Free-Time Companion (Capacitor iOS + Web)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "start": "node server.js",
    "ios": "cap sync ios && cap open ios",
    "sync": "git add . && git commit -m 'chore: sync updates from Antigravity' && git push origin main",
    "test:logic": "vitest run tests/logic.test.js",
    "test:nav": "playwright test tests/nav.spec.js"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.0",
    "@capacitor/browser": "^6.0.0",
    "@capacitor/camera": "^6.0.0",
    "@capacitor/clipboard": "^6.0.0",
    "@capacitor/core": "^6.2.3",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/ios": "^6.2.3",
    "@capacitor/keyboard": "^6.0.0",
    "@capacitor/preferences": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@fontsource/bricolage-grotesque": "^5.0.0",
    "@fontsource/manrope": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.3",
    "@playwright/test": "^1.48.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
